; The ROS 2 / Autoware classes, built with godot_rviz2/ (see its CMakeLists.txt, which generates
; this file) into bin/ next to it
[configuration]

entry_symbol = "godot_rviz2_library_init"
compatibility_minimum = "@GODOT_API_VERSION@"

[libraries]

linux.x86_64 = "res://addons/godot_rviz2/bin/libgodot_rviz2.linux.x86_64.so"
linux.arm64 = "res://addons/godot_rviz2/bin/libgodot_rviz2.linux.arm64.so"
